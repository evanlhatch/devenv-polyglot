export DIRENV_WARN_TIMEOUT=20s

# Use stable devenv cache path to prevent rebuilds
export DEVENV_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/devenv/$PWD"

# Load devenv direnvrc
eval "$(devenv direnvrc)"

# Use devenv with eval cache for speed (prevents unnecessary Nix evaluations)
# --eval-cache is safe and significantly speeds up directory changes
use devenv --eval-cache || use devenv

# Load Infisical secrets (idempotent - only once per shell session)
if [[ -z "$INFISICAL_LOADED" ]] && command -v infisical >/dev/null 2>&1; then
  eval "$(infisical export)"
  export INFISICAL_LOADED=1
fi
